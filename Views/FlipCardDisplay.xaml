<UserControl x:Class="ManaHub.Views.FlipCardDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ManaHub.Views"
             xmlns:conv="clr-namespace:ManaHub.Converters"
             xmlns:svg="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             xmlns:helpers="clr-namespace:ManaHub.Helpers"
             d:DesignHeight="315" d:DesignWidth="225" mc:Ignorable="d">
    <ContentControl Content="{Binding}">
        <ContentControl.Template>
            <ControlTemplate TargetType="ContentControl">
                <Border BorderBrush="#111111" Background="#444444" BorderThickness="5" CornerRadius="15">
                    <Grid>
                        <Grid x:Name="LargeRotatingGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="CardRotation" Angle="0" />
                            </Grid.RenderTransform>

                            <Grid.RowDefinitions>
                                <RowDefinition Height=".5*" />
                                <RowDefinition Height=".5*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Vertical">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{Binding CardDisplay.Name}" TextTrimming="CharacterEllipsis" 
                                                       Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding CardDisplay.ManaCost, Converter={StaticResource SymbolToImageConverter}}" 
                                                          Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <svg:SvgViewbox UriSource="{Binding}" Width="12" Height="12" Margin="1,0"  
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Left" Text="{Binding CardDisplay.TypeLine}"
                                                       Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock HorizontalAlignment="Right" Text="{Binding CardDisplay.Set}"
                                                       Foreground="#FFD700" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        </Grid>
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <TextBlock helpers:TextBlockHelper.FormattedText="{Binding CardDisplay.OracleText}" 
                                               TextWrapping="Wrap" Foreground="White" FontSize="11" LineHeight="10" />
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#AAAAAA" CornerRadius="12,0,12,0" 
                                                Padding="8,4" Margin="-5,-5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CardDisplay.Power}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                                <TextBlock Text="/" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                                <TextBlock Text="{Binding CardDisplay.Toughness}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,1,0,0" Padding="5">
                                <Grid>
                                    <Grid x:Name="SmallRotatingGrid" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="180" />
                                        </Grid.RenderTransform>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Vertical">
                                            <TextBlock HorizontalAlignment="Left" Text="{Binding CardDisplay.SecondName}" TextTrimming="CharacterEllipsis" 
                                           Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock HorizontalAlignment="Left" Text="{Binding CardDisplay.SecondTypeLine}" 
                                           Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <TextBlock helpers:TextBlockHelper.FormattedText="{Binding CardDisplay.SecondOracleText}" 
                                   TextWrapping="Wrap" Foreground="White" FontSize="11" LineHeight="10" />
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#AAAAAA" CornerRadius="12,0,12,0" 
                                            Padding="8,4" Margin="-5,-5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding CardDisplay.SecondPower}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                                    <TextBlock Text="/" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                                    <TextBlock Text="{Binding CardDisplay.SecondToughness}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                                </StackPanel>
                                            </Border>
                                            <Button x:Name="FlipButton" VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                                                    Width="25" Height="25" Background="White" Command="{Binding FlipCardCommand}">
                                                <svg:SvgViewbox x:Name="FlipIcon" UriSource="pack://application:,,,/ManaHub;component/Assets/ActionSymbols/black-flip.svg" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation 
                        Storyboard.TargetName="LargeRotatingGrid" 
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" 
                        To="180" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation 
                        Storyboard.TargetName="LargeRotatingGrid" 
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" 
                        To="0" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                        <Setter TargetName="FlipButton" Property="Background" Value="Black" />
                        <Setter TargetName="FlipIcon" Property="UriSource" Value="pack://application:,,,/ManaHub;component/Assets/ActionSymbols/white-flip.svg" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ContentControl.Template>
    </ContentControl>
</UserControl>
