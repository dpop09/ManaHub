<UserControl x:Class="ManaHub.Views.CardDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ManaHub.Views"
             xmlns:conv="clr-namespace:ManaHub.Converters"
             xmlns:svg="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             xmlns:helpers="clr-namespace:ManaHub.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="315" d:DesignWidth="225">
    <UserControl.Resources>
        <DataTemplate x:Key="NormalCardTemplate">
            <local:NormalCardDisplay DataContext="{Binding}" />
        </DataTemplate>

        <DataTemplate x:Key="SplitCardTemplate">
            <local:SplitCardDisplay DataContext="{Binding}" />
        </DataTemplate>

        <DataTemplate x:Key="TransformCardTemplate">
            <local:TransformCardDisplay DataContext="{Binding}" />
        </DataTemplate>

        <DataTemplate x:Key="AdventureCardTemplate">
            <local:AdventureCardDisplay DataContext="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>
    <ContentControl Content="{Binding}">
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="ContentTemplate" Value="{StaticResource NormalCardTemplate}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CardDisplay.Layout}" Value="split">
                        <Setter Property="ContentTemplate" Value="{StaticResource SplitCardTemplate}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CardDisplay.Layout}" Value="transform">
                        <Setter Property="ContentTemplate" Value="{StaticResource TransformCardTemplate}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CardDisplay.Layout}" Value="modal_dfc">
                        <Setter Property="ContentTemplate" Value="{StaticResource TransformCardTemplate}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CardDisplay.Layout}" Value="adventure">
                        <Setter Property="ContentTemplate" Value="{StaticResource AdventureCardTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
</UserControl>