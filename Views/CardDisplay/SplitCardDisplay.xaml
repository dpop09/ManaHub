<UserControl x:Class="ManaHub.Views.SplitCardDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ManaHub.Views"
             xmlns:conv="clr-namespace:ManaHub.Converters"
             xmlns:svg="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             xmlns:helpers="clr-namespace:ManaHub.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="315" d:DesignWidth="225">
    <Border BorderBrush="#111111" Background="#444444" BorderThickness="5" CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height=".5*" />
                <RowDefinition Height=".5*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{Binding CardDisplay.Front.Name}" TextTrimming="CharacterEllipsis"
                                           Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding CardDisplay.Front.ManaCost, Converter={StaticResource SymbolToImageConverter}}"
                                              Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <svg:SvgViewbox UriSource="{Binding}" Width="12" Height="12" Margin="1,0"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Grid>
                            <TextBlock HorizontalAlignment="Left" Text="{Binding CardDisplay.Front.TypeLine}"
                                           Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding CardDisplay.SetCode}"
                                           Foreground="#FFD700" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <TextBlock helpers:TextBlockHelper.FormattedText="{Binding CardDisplay.Front.OracleText}"
                                   TextWrapping="Wrap" Foreground="White" FontSize="11" LineHeight="10" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,1,0,0" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{Binding CardDisplay.Back.Name}" TextTrimming="CharacterEllipsis"
                                           Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding CardDisplay.Back.ManaCost, Converter={StaticResource SymbolToImageConverter}}"
                                              Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <svg:SvgViewbox UriSource="{Binding}" Width="12" Height="12" Margin="1,0"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Grid>
                            <TextBlock HorizontalAlignment="Left" Text="{Binding CardDisplay.Back.TypeLine}"
                                           Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding CardDisplay.SetCode}"
                                           Foreground="#FFD700" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <TextBlock helpers:TextBlockHelper.FormattedText="{Binding CardDisplay.Back.OracleText}"
                                   TextWrapping="Wrap" Foreground="White" FontSize="11" LineHeight="10" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
