<UserControl x:Class="ManaHub.Views.TransformCardDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ManaHub.Views"
             xmlns:conv="clr-namespace:ManaHub.Converters"
             xmlns:svg="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             xmlns:helpers="clr-namespace:ManaHub.Helpers"
             mc:Ignorable="d" d:DesignHeight="315" d:DesignWidth="225">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StatToVisibility" />
    </UserControl.Resources>
    <ContentControl Content="{Binding}">
        <ContentControl.Template>
            <ControlTemplate TargetType="ContentControl">
                <Border BorderBrush="#111111" BorderThickness="5" CornerRadius="15">
                    <Grid x:Name="RootGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#444444" Padding="5" CornerRadius="12,12,0,0">
                            <StackPanel Orientation="Vertical">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NameText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Text="{Binding CardDisplay.Name}" TextTrimming="CharacterEllipsis" Foreground="White" 
                                               FontWeight="Bold" FontSize="11" />
                                    <ItemsControl x:Name="ManaCostControl" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  ItemsSource="{Binding CardDisplay.ManaCost, Converter={StaticResource SymbolToImageConverter}}" 
                                                  Margin="5,0,0,0" >
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <svg:SvgViewbox UriSource="{Binding}" Width="12" Height="12" Margin="1,0" 
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <Grid>
                                    <TextBlock x:Name="TypeLineText" HorizontalAlignment="Left" Text="{Binding CardDisplay.TypeLine}" 
                                               Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding CardDisplay.Set}" 
                                               Foreground="#FFD700" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="#444444" CornerRadius="0,0,12,12" Padding="5">
                            <Grid>
                                <TextBlock x:Name="OracleTextBlock" helpers:TextBlockHelper.FormattedText="{Binding CardDisplay.OracleText}"
                                           TextWrapping="Wrap" Foreground="White" FontSize="11" LineHeight="10" />
                                <Button x:Name="FlipButton" VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                                            Width="25" Height="25" Background="White" Command="{Binding FlipCardCommand}">
                                    <svg:SvgViewbox x:Name="FlipIcon" UriSource="pack://application:,,,/ManaHub;component/Assets/ActionSymbols/black-flip.svg" />
                                </Button>
                                <Border x:Name="PTBorder" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#AAAAAA" 
                                        CornerRadius="12,0,12,0" Padding="8,4" Margin="-5,-5" 
                                        Visibility="{Binding CardDisplay.Power, Converter={StaticResource StatToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PowerText" Text="{Binding CardDisplay.Power}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                        <TextBlock Text="/" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                        <TextBlock x:Name="ToughnessText" Text="{Binding CardDisplay.Toughness}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                        <Setter TargetName="NameText" Property="Text" Value="{Binding CardDisplay.SecondName}" />
                        <Setter TargetName="ManaCostControl" Property="ItemsSource" Value="{Binding CardDisplay.SecondManaCost, Converter={StaticResource SymbolToImageConverter}}" />
                        <Setter TargetName="TypeLineText" Property="Text" Value="{Binding CardDisplay.SecondTypeLine}" />
                        <Setter TargetName="OracleTextBlock" Property="helpers:TextBlockHelper.FormattedText" Value="{Binding CardDisplay.SecondOracleText}" />
                        <Setter TargetName="PTBorder" Property="Visibility" Value="{Binding CardDisplay.SecondPower, Converter={StaticResource StatToVisibility}}" />
                        <Setter TargetName="PowerText" Property="Text" Value="{Binding CardDisplay.SecondPower}" />
                        <Setter TargetName="ToughnessText" Property="Text" Value="{Binding CardDisplay.SecondToughness}" />
                        <Setter TargetName="FlipButton" Property="Background" Value="Black" />
                        <Setter TargetName="FlipIcon" Property="UriSource" Value="pack://application:,,,/ManaHub;component/Assets/ActionSymbols/white-flip.svg" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ContentControl.Template>
    </ContentControl>
</UserControl>
